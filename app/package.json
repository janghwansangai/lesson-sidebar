{
  "name": "lesson-sidebar",
  "productName": "수업 사이드바",
  "version": "0.3.6",
  "private": true,
  "description": "수업 사이드바 — 수업 자료를 원래 프로그램으로 열고 사이드바 하나로 창을 관리하는 프로그램",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "build:helper": "npm --prefix ../poc run build:mac",
    "dist:mac": "npm run electron:get && npm run build:helper && electron-builder --mac --arm64",
    "dist:mac:dir": "npm run electron:get && npm run build:helper && electron-builder --mac --arm64 --dir",
    "smoke:mac": "node scripts/smoke-packaged.mjs",
    "build:win-helper": "npm --prefix ../poc/win-helper install --no-audit --no-fund",
    "dist:win": "npm run electron:get && npm run build:win-helper && electron-builder --win --x64 --publish never",
    "dist:win:dir": "npm run electron:get && npm run build:win-helper && electron-builder --win --x64 --dir --publish never",
    "smoke:win": "node scripts/smoke-packaged.mjs",
    "electron:get": "node node_modules/electron/install.js",
    "icon": "rsvg-convert -w 1024 -h 1024 build/icon.svg -o build/icon.png"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "kr.lessonsidebar.app",
    "productName": "LessonSidebar",
    "copyright": "수업 사이드바",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../poc/lib",
        "to": "poc/lib",
        "filter": [
          "*.js"
        ]
      },
      {
        "from": "../poc/package.json",
        "to": "poc/package.json"
      },
      {
        "from": "sample-lesson",
        "to": "sample-lesson",
        "filter": [
          "**/*",
          "!.sidebar/**",
          "!**/~$*",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "lesson-sidebar-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleDisplayName": "LessonSidebar",
        "LSHasLocalizedDisplayName": true,
        "NSMicrophoneUsageDescription": "수업을 녹화할 때 선생님 목소리를 함께 남기려고 마이크를 씁니다."
      },
      "extraResources": [
        {
          "from": "../poc/mac-helper/.build/release/winctl",
          "to": "winctl"
        },
        {
          "from": "build/ko.lproj",
          "to": "ko.lproj"
        },
        {
          "from": "build/en.lproj",
          "to": "en.lproj"
        }
      ]
    },
    "dmg": {
      "title": "수업 사이드바 ${version}",
      "filesystem": "APFS"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "lesson-sidebar-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../poc/win-helper",
          "to": "win-helper",
          "filter": [
            "winctl.js",
            "package.json"
          ]
        },
        {
          "from": "../poc/win-helper/node_modules",
          "to": "win-helper/node_modules",
          "filter": [
            "koffi/**/*",
            "@koromix/koffi-win32-x64/**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "수업 사이드바",
      "uninstallDisplayName": "수업 사이드바",
      "artifactName": "lesson-sidebar-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "lesson-sidebar-${version}-win-portable.${ext}"
    },
    "afterPack": "build/after-pack.cjs",
    "electronFuses": {
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "afterSign": "build/sign-local.cjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
